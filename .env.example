# Server
HOST=127.0.0.1
PORT=8788
PUBLIC_URL=http://localhost:8788

# Replace this placeholder with a unique secret of at least 32 characters.
ADMIN_TOKEN=CHANGE_ME_TO_A_UNIQUE_32_CHARACTER_SECRET
# Optional separate 32+ character encryption key for saved Telegram credentials.
# Keep this stable when rotating ADMIN_TOKEN. If unset, ADMIN_TOKEN encrypts settings.
SETTINGS_KEY=

# Workspace
DB_PATH=data/threadpost.sqlite
SITE_ID=demo
SITE_NAME=Demo site
ALLOWED_ORIGINS=http://localhost:8788

# Optional locally; configure both for public deployments. See docs/turnstile-setup.md.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MAX_NEW_CONVERSATIONS_PER_DAY=200
MAX_MESSAGES_PER_DAY=5000

# Connector: demo or telegram
CONNECTOR=demo
TELEGRAM_BOT_TOKEN=
# Negative numeric ID of the private forum supergroup, for example -1001234567890.
TELEGRAM_CHAT_ID=
# Comma-separated numeric Telegram user IDs.
TELEGRAM_OPERATOR_IDS=
# Required for Telegram; replace with a unique secret of at least 32 characters.
TELEGRAM_WEBHOOK_SECRET=
